# Cowrie, the honeypot's SSH front end, as a service that survives a reboot.
# Goes to /etc/systemd/system/cowrie.service on the Orchestrator; installed by
# scripts/orch_install_cowrie.sh. Explained in docs/orchestrator-services.md.
[Unit]
Description=Cowrie SSH front end (honeypot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cowrie
Group=cowrie
WorkingDirectory=/home/cowrie/cowrie
# Cowrie looks up twistd on the PATH; without its own bin/ first it does not start.
Environment=PATH=/home/cowrie/cowrie/cowrie-env/bin:/usr/bin:/bin
# The same command `cowrie start` builds, kept in the foreground (-n) so that systemd
# sees the process, with no pid file. Cowrie's own log stays in var/log/cowrie/.
ExecStart=/home/cowrie/cowrie/cowrie-env/bin/twistd --umask=0077 -n --pidfile= --logger cowrie.python.logfile.logger cowrie
Restart=on-failure
RestartSec=2

# The one privilege Cowrie gets: binding a port below 1024, needed for port 22. It
# must bind 22 itself (not sit behind a redirect from 22 to 2222), because the port it
# listens on is what the relay prints as the server port in `env` and `who`.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# A break-out from Cowrie lands here: no other user's files, a read-only system, and
# write access to Cowrie's own var/ only.
ProtectSystem=strict
ReadWritePaths=/home/cowrie/cowrie/var
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
