# ---- Python and editor junk
.venv/
__pycache__/
*.pyc
.env

# ---- Local secrets: the real site values (addresses, MACs, the credentials the simulated
# machine serves). honeypot/site.py reads this file; site.example.json is the committed
# copy with made-up values of the same lengths.
site.local.json

# ---- Measurement output (run files, logs, sheets, harness folders); regenerated by the
# tools and kept out of the repository.
res_*.json
res_*.jsonl
res_*.html
res_*.csv
res_*.console
res_measure_*.log
res_build_*.txt
res_rehearsal_*.json
res_harness_*/
/rehearsal-*/
/ssh_offer_*.json

# ---- The relay's runtime state and session logs
relay-state/
relay-logs/

# ---- Staged offline artefacts for the lab (no internet there). Large binaries and
# refetchable downloads; the manifests, lock files and checksums next to them stay tracked.
offline/**/*.deb
offline/**/*.tar
offline/**/*.whl
offline/**/*.tar.zst
offline/**/*.gguf
offline/**/*.bak
offline/llama.cpp-*/
offline/pkg-index/
offline/man-index/
offline/gt-probe.txt
offline/debian13-arm64/rootfs/
offline/debian13-arm64/proot
offline/debian13-arm64/qemu-aarch64-static
offline/docker-cli/
offline/openssh-gt/work/
offline/tex/
offline/prior/
offline/papers/
offline/config-deployed-*.json
offline/relaylog-*.jsonl

# ---- Team-only data: training sets and models built from the recordings, and what comes
# back from training (both contain the reference machine's credentials).
offline/training/
offline/finetune-results/
offline/finetune-models/
/offline/from-bob/
/offline/bob-llama1b-results/

# ---- The data bundle for the team: built from the tracked originals by
# scripts/build_share_bundle.sh (its README stays tracked).
share/**/*.json
share/*.zip

# ---- Paper build output and local working folders (never part of the repository)
paper/figures/*.png
/paper-upload/
/paper.zip
paper-sync/
to-school/
to-school-sent/
assistant-brief/
/from-github/
/cowrie-clean-export*/
/cowrie-clean-export*.tar.gz
/cowrie-rick/
PROJECT-EXPLAINED.md
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
